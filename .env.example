AUTH_SECRET=replace-with-a-long-random-secret
DEMO_USER_EMAIL=demo@nawaiam.com
DEMO_USER_PASSWORD=demo1234

# Vercel Postgres
# DATABASE_URL should use the pooled URL (POSTGRES_PRISMA_URL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DB_NAME?pgbouncer=true&connect_timeout=15&schema=public
# DIRECT_URL should use the non-pooled URL (POSTGRES_URL_NON_POOLING)
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public
