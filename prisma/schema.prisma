generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model GameResult {
  id        String   @id @default(cuid())
  email     String
  userName  String
  gameId    String
  gameTitle String
  score     Int
  total     Int
  label     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}
